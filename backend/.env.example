APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Signing in sends a six-digit code to the address on the account, so
# these settings are not optional on a real server: if mail does not work,
# nobody logs in. Set them before the first person needs to, and prove it
# with  php artisan amaso:mail-test you@example.com
#
# "log" writes the email to storage/logs/laravel.log instead of sending it.
# That is right for a developer machine and wrong for a server - leave it
# here so a fresh checkout runs, and change it on deployment.
MAIL_MAILER=log

# The association's own mailbox is the better sender, and the one to prefer:
# the address staff see matches the domain the system runs on, there are no
# app passwords to manage, and a code from system@amaso.site is obviously
# the association rather than somebody's personal Gmail.
#
# Hostinger (which is where amaso.site is hosted):
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=system@amaso.site
#   MAIL_PASSWORD=<the mailbox password>
#   MAIL_FROM_ADDRESS=system@amaso.site
#
# Port 465 with MAIL_SCHEME=smtps is TLS from the first byte. Port 587 with
# MAIL_SCHEME left as null works too and upgrades with STARTTLS; 465 is the
# simpler of the two because there is no upgrade step to fail.
#
# MAIL_FROM_ADDRESS must be the same mailbox as MAIL_USERNAME. Mail servers
# reject a message claiming to come from an address the sender did not
# authenticate as - the one mistake that produces a working test and then
# silent failures in production.
#
# Gmail also works, if the association would rather use an existing account.
# The catch is that MAIL_PASSWORD must be a 16-character app password, not
# the account's own, and Google only offers app passwords once 2-Step
# Verification is on for that Google account
# (myaccount.google.com/apppasswords - paste it without the spaces shown):
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null
#   MAIL_USERNAME=amaso.association@gmail.com
#   MAIL_PASSWORD=abcdefghijklmnop
#   MAIL_FROM_ADDRESS=amaso.association@gmail.com
#
MAIL_SCHEME=null
#   MAIL_USERNAME=amaso.association@gmail.com
#   MAIL_PASSWORD=abcdefghijklmnop
#   MAIL_FROM_ADDRESS=amaso.association@gmail.com
#
# Gmail rewrites the sender to the account it authenticated as, so
# MAIL_FROM_ADDRESS must be that same address or the mail is rejected.
# Free Gmail sends roughly 500 messages a day, which is far more than an
# association of this size signs in.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# What staff see as the sender. Arabic is fine - it is encoded in the
# header and arrives intact.
MAIL_FROM_NAME="جمعية المنصور لكفالة اليتيم"

# Passwords expire after 30 days, and a login code is worth typing for 10
# minutes. Both live in the settings table rather than here, so they can be
# changed on a running server without a release:
#
#   php artisan amaso:password-policy --days=60
#
# Days of 0 switches expiry off entirely.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The association's identity on generated reports. These are defaults only -
# an admin can override each of them from the settings screen.
ORG_NAME="جمعية المنصور لكفالة اليتيم"
ORG_ADDRESS=
ORG_PHONE=
ORG_EMAIL=
