# =================================================
# AMASO - Configuration du frontend Next.js
# =================================================
#
# Copiez ce fichier dans frontend/.env.local
# (install.bat le fait automatiquement).
#
# Redemarrez le serveur apres chaque modification : Next.js lit ces
# variables au demarrage.
#
# Les variables NEXT_PUBLIC_* sont integrees au code envoye au
# navigateur. N'y mettez jamais de mot de passe ni de cle privee.


# -------------------------------------------------
# Adresse de l'API Laravel  (la seule variable obligatoire)
# -------------------------------------------------
# Poste local          http://localhost:8000/api/v1
# Serveur de l'association, meme machine que le frontend :
#                      /api/v1
# Serveur distant      https://amaso.exemple.ma/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1


# -------------------------------------------------
# Options facultatives
# -------------------------------------------------

# Port du serveur de developpement. Par defaut 3000.
# PORT=3000

# Desactive l'envoi de statistiques d'usage a Vercel par Next.js.
NEXT_TELEMETRY_DISABLED=1


# -------------------------------------------------
# Ce qui NE se configure pas ici
# -------------------------------------------------
# Le nom de l'association, son adresse, son telephone et son courriel
# apparaissent sur les rapports imprimes. Ils se modifient depuis
# l'application : Parametres > Informations de l'association.
#
# La langue (arabe), le sens de lecture (droite a gauche) et la monnaie
# (dirham marocain) sont fixes dans le code, pas configurables.
